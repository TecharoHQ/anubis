[Unit]
Description="Anubis HTTP defense proxy (instance %i)"

[Service]
ExecStart=/usr/bin/anubis
Restart=always
RestartSec=30s
EnvironmentFile=/etc/anubis/%i.env
LimitNOFILE=infinity
DynamicUser=yes
CacheDirectory=anubis/%i
CacheDirectoryMode=0755
StateDirectory=anubis/%i
StateDirectoryMode=0755
RuntimeDirectory=anubis/%i
RuntimeDirectoryMode=0755
# /var/lib/anubis is shared by every instance (such as for GeoIP databases).
# Each instance runs as its own dynamic user, so access is granted through the
# static anubis group. These run as root before Anubis starts so that it works
# without a reboot after install and for manual installs of this unit.
ExecStartPre=-+/usr/bin/systemd-sysusers --inline "g anubis -"
ExecStartPre=+/usr/bin/install -d -m 2775 -o root -g anubis /var/lib/anubis
SupplementaryGroups=anubis
ReadWritePaths=/run -/var/lib/anubis

[Install]
WantedBy=multi-user.target