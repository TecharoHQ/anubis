# Anubis service configuration.
#
# Edit this file, then start the service:
#   sc start anubis
#
# To start Anubis automatically at boot:
#   sc config anubis start= auto
#
# Every setting here matches a command line flag. See
# https://anubis.techaro.lol/docs/admin/installation for the full list.

# Address Anubis listens on.
BIND=:8923

# The server Anubis protects. Requests that pass the challenge are proxied here.
TARGET=http://localhost:3923

# Policy file. Edit it to change which bots are challenged, denied or allowed.
# The installer writes the real directory here. It is normally the Techaro
# folder under C:\ProgramData, but %ProgramData% can be moved to another
# drive, so the shipped template does not name one.
POLICY_FNAME=__ANUBIS_DATA_DIR__\anubis.yaml

# Log level: DEBUG, INFO, WARN or ERROR.
SLOG_LEVEL=INFO

# Signing key, exactly 64 hexadecimal characters. If this is not set, Anubis
# generates a random key at every start, which invalidates every outstanding
# challenge whenever the service restarts. Set it before going to production.
# ED25519_PRIVATE_KEY_HEX=

# Comma separated domains Anubis may redirect to. Leaving this unset allows any
# domain. See
# https://anubis.techaro.lol/docs/admin/configuration/redirect-domains
# REDIRECT_DOMAINS=
